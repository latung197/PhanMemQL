{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "ServerService/Core/Core.csproj", "--no-launch-profile", "-e", "ASPNETCORE_ENVIRONMENT=Development", "--urls", "http://localhost:2512"],
      "port": 2512
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "Frontend", "run", "dev"],
      "port": 3000
    }
  ]
}
